---
const { title, subtitle } = Astro.props;
---

<section class="page-hero">
  <h1>{title}</h1>
  {subtitle && <p>{subtitle}</p>}
</section>

<style>
.page-hero {
  padding: 6rem 2rem 4rem;
  max-width: 900px;
  margin: 0 auto;
}

.page-hero h1 {
  font-size: 2.5rem;
  font-weight: 500;
}

.page-hero p {
  margin-top: 1rem;
  opacity: 0.7;
  max-width: 600px;
}
</style>
