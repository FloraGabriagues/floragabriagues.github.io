---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate h-screen overflow-hidden"
  style={`--accent-color: ${siteConfig.accentColor}`}

  <!-- Image credit -->
<div class="absolute bottom-4 right-6 z-10 pointer-events-none">
  <p class="image-credit">
    Source: Sentinel-2, Copernicus Programme, ESA
  </p>
</div>

>
  <!-- Background image -->
  <div
    class="absolute inset-0 -z-30 bg-cover bg-center"
    style="
      background-image: url('/images/satellite.jpg');
      filter: contrast(1.15) saturate(1.1);
    "
  ></div>

  <!-- Dark overlay -->
  <div class="absolute inset-0 -z-20 bg-black/20"></div>

  <!-- Programming symbols overlay -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full pointer-events-none"
  >
    <defs>
      <pattern
        id="programming-symbols"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text x="40" y="60" fill="white" opacity="0.6" font-family="monospace" font-size="24">&lt;/&gt;</text>
        <text x="160" y="120" fill="white" opacity="0.5" font-family="monospace" font-size="20">{}</text>
        <text x="260" y="90" fill="white" opacity="0.5" font-family="monospace" font-size="18">=&gt;</text>
        <text x="120" y="220" fill="white" opacity="0.6" font-family="monospace" font-size="22">[]</text>
        <text x="300" y="200" fill="white" opacity="0.5" font-family="monospace" font-size="20">&lt;&gt;</text>
        <text x="220" y="300" fill="white" opacity="0.4" font-family="monospace" font-size="24">()</text>
        <text x="80" y="340" fill="white" opacity="0.4" font-family="monospace" font-size="18">::</text>
      </pattern>
    </defs>

    <rect
      width="100%"
      height="100%"
      fill="url(#programming-symbols)"
      opacity="0.12"
    />
  </svg>

  <!-- Main content -->
  <div class="relative z-20 mx-auto h-full p-8 sm:p-12 md:p-24 flex items-center">
    <div>
      <h2
          class="
            hero-text
            welcome
            text-xl sm:text-2xl md:text-4xl
            font-semibold tracking-tight
            text-white
            animate-fade-in
          "
      >
        Welcome!
      </h2>

      <h1
        class="hero-text mt-6 text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-white animate-fade-in animation-delay-200"
      >
        I’m
        <span style={{ color: siteConfig.accentColor }}>
          {siteConfig.name}
        </span>
      </h1>

      <p
        class="hero-text mt-6 text-base sm:text-lg md:text-xl font-medium text-white animate-fade-in animation-delay-400"
      >
        {siteConfig.title}
      </p>
    </div>
  </div>

  <!-- Social links -->
  <div
    class="absolute bottom-0 left-0 right-0 z-20 p-8 sm:p-12 md:p-24 flex gap-x-6 text-white/80 animate-fade-in animation-delay-600"
  >
    {siteConfig.social?.email && (
      <a
        href={`mailto:${siteConfig.social.email}`}
        aria-label="Email"
        class="
          transition-all duration-300
          text-white
          drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]
          hover:drop-shadow-[0_4px_14px_rgba(0,0,0,0.9)]
          hover:scale-110
          hover:text-[var(--accent-color)]
        "
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
          <path d="M3 7l9 6l9 -6" />
        </svg>
      </a>
    )}

    {siteConfig.social?.linkedin && (
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="
          transition-all duration-300
          text-white
          drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]
          hover:drop-shadow-[0_4px_14px_rgba(0,0,0,0.9)]
          hover:scale-110
          hover:text-[var(--accent-color)]
        "
      >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
      class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M8 11v5" />
      <path d="M8 8v.01" />
      <path d="M12 16v-5" />
      <path d="M16 16v-3a2 2 0 1 0 -4 0" />
      <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
    </svg>
      </a>
    )}

    {siteConfig.social?.github && (
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="
          transition-all duration-300
          text-white
          drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]
          hover:drop-shadow-[0_4px_14px_rgba(0,0,0,0.9)]
          hover:scale-110
          hover:text-[var(--accent-color)]
        "
      >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
      class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5
      c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4
      5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2
      a4.2 4.2 0 0 0 -.1 -3.2
      s-1.1 -.3 -3.5 1.3
      a12.3 12.3 0 0 0 -6.2 0
      c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3
      a4.2 4.2 0 0 0 -.1 3.2
      a4.6 4.6 0 0 0 -1.3 3.2
      c0 4.6 2.7 5.7 5.5 6
      c-.6 .6 -.6 1.2 -.5 2v3.5" />
      </svg>
      </a>
    )}
  </div>
</div>

<style>
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-text {
  text-shadow:
    0 2px 6px rgba(0, 0, 0, 0.6),
    0 10px 28px rgba(0, 0, 0, 0.5);
}

.animate-fade-in {
  animation: fadeIn 0.8s ease-out forwards;
  opacity: 0;
}

.animation-delay-200 { animation-delay: 0.2s; }
.animation-delay-400 { animation-delay: 0.4s; }
.animation-delay-600 { animation-delay: 0.6s; }

.image-credit {
  font-size: 0.7rem;              /* plus petit */
  line-height: 1.2;
  color: rgb(255, 255, 255); /* blanc gris */
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
}

</style>

