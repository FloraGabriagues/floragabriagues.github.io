---
import { siteConfig } from "../config";
const { missions = [] } = Astro.props;
---

<section class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

    <!-- Colonne titre -->
    <div class="lg:col-span-4">
      <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
        Mission Types
      </h2>

      <div
        class="w-[75px] h-[5px] mt-2 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      />

      <p
        class="mt-6 text-lg sm:text-xl md:text-2xl font-mono uppercase tracking-widest"
        style={`color: ${siteConfig.accentColor}`}
      >
        Satellite Images Users
      </p>
      <p class="mt-4 max-w-xl text-sm sm:text-base text-gray-600 leading-relaxed">
        The following missions illustrate typical engagement formats. Each mission can be fully tailored to match the client’s objectives, timeline, and technical context.
      </p>
      <div class="p-8 sm:p-12 md:p-16 lg:p-24 pt-0">
    <div class="max-w-4xl mx-auto text-center">
    <a
      href="mailto:flora.gabriagues@etik.com"
      class="inline-flex items-center gap-3 px-6 py-3 rounded-full
             text-white font-medium
             transition-all duration-300
             hover:shadow-lg hover:-translate-y-0.5"
      style={`background-color: ${siteConfig.accentColor}`}
    >
      Contact me
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 7l9 6 9-6" />
        <path d="M21 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7" />
      </svg>
    </a>
  </div>
</div>


    </div>

    <!-- Colonne contenu -->
    <div class="lg:col-span-8 space-y-6">
      {missions.map((mission) => (
        <div
  class="bg-gray-50/70 border border-gray-200 rounded-lg p-5
         hover:border-gray-300 hover:bg-white hover:shadow-[0_4px_20px_rgba(0,0,0,0.04)]
         transition-all duration-300"
>


          <!-- Header -->
          <div class="flex flex-col sm:flex-row sm:justify-between mb-4">
            <div>
              <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                {mission.title}
              </h3>
              <p style={`color: ${siteConfig.accentColor}`}>
                {mission.phase}
              </p>
            </div>
            <span class="text-sm text-gray-500 mt-2 sm:mt-0">
              {mission.duration}
            </span>
          </div>

          <!-- Scope -->
          <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">
            Scope
          </p>
          <ul class="space-y-1.5">
            {mission.bullets.map((item) => (
              <li class="flex gap-3">
                <span class="w-1.5 h-1.5 mt-2 rounded-full bg-gray-400" />
                <span class="text-sm sm:text-base text-gray-600">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Expandable -->
          {(mission.milestones || mission.deliverables) && (
            <details class="group mt-4">
            <summary
            class="mt-4 inline-flex items-center gap-2
                    px-3 py-1.5
                    rounded-md border border-gray-200
                    text-sm font-medium
                    text-gray-600
                    cursor-pointer
                    hover:text-gray-900 hover:border-gray-300 hover:bg-gray-50
                    transition-colors"
            >
            <span>See typical milestones & deliverables</span>
            <svg
                class="w-4 h-4 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
                />
            </svg>
            </summary>


              <div class="mt-4 space-y-4">

                {mission.milestones && (
                  <div>
                    <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">
                      Typical milestones
                    </p>
                    <ul class="space-y-1.5">
                      {mission.milestones.map((ms) => (
                        <li class="flex gap-3">
                          <span
                            class="w-1.5 h-1.5 mt-2 rounded-full"
                            style={`background-color: ${siteConfig.accentColor}`}
                          />
                          <span class="text-sm text-gray-600">{ms}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {mission.deliverables && (
                  <div>
                    <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">
                      Deliverables
                    </p>
                    <ul class="space-y-1.5">
                      {mission.deliverables.map((del) => (
                        <li class="flex gap-3">
                          <span class="w-1.5 h-1.5 mt-2 rounded-full bg-gray-300" />
                          <span class="text-sm text-gray-600">{del}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

              </div>
            </details>
          )}

        </div>
      ))}
    </div>

  </div>
</section>
